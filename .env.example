# Copy to .env (same folder as netradio.js). Real environment variables override these.
# On Pterodactyl the port comes from the allocation (SERVER_PORT) automatically.

STATION_NAME=Gizmo Radio
STATION_DESCRIPTION=Continuous shuffled songs with bumpers
STATION_GENRE=Mixed

# Public base URL (behind your reverse proxy), used in /now.json and the web page
#PUBLIC_URL=https://radio.example.com

BITRATE=192
BUMPER_EVERY=1
# Station clock: used for the log timestamps and the top-of-hour time checks in intros/hourly/.
# Use a zone name (handles EST/EDT automatically), not a fixed offset. The container's own TZ
# is ignored, so set this if you are not on US Eastern.
STATION_TZ=America/New_York
#HOURLY_GRACE_MINUTES=20
# Playlist to start with: 'default' (loose files in songs/), a songs/<folder> name, 'all', or 'a,b'.
# Once you use the `playlist` command the choice is saved in playlist-state.json and survives
# restarts, and these two are ignored until `playlist reset`.
PLAYLIST=default
# random (shuffled, the usual) or sequential (natural filename order, loops)
#PLAYLIST_ORDER=random
NORMALIZE=1
# NORMALIZE=1 aligns loudness (recommended); NORMALIZE=peak aligns every track's peak instead; 0 = off
# Loudness target (LUFS) and true-peak ceiling (dBTP) for the fixed per-track gain
#NORMALIZE_TARGET=-16
#NORMALIZE_PEAK=-1
# Bumpers/intros this many dB below the songs
#BUMPER_OFFSET_DB=-3
BURST_SECONDS=8

# Enables POST /skip?token=... and POST /reload?token=...
#ADMIN_TOKEN=change-me

# HLS stream at /hls/live.m3u8 — this is the URL for VRChat (AVPro). Set 0 to disable.
HLS=1
# Playlist length in segments (x4 s). AVPro starts at the first one, so this is the tune-in delay. Keep small.
#HLS_WINDOW_SEGMENTS=6
# Expired segments kept on disk (x4 s) so a player that fell behind can still fetch them.
#HLS_KEEP_SEGMENTS=15

# Only if ffmpeg is not on PATH inside the container
#FFMPEG_PATH=/home/container/bin/ffmpeg
#FFPROBE_PATH=/home/container/bin/ffprobe

# Bumper processing: files dropped in intros/raw/ get the Audacity-style Echo
# (delay 0.01 s, decay 0.5) and are peak-normalised, then land in intros/generic/
#PROCESS_ECHO_DELAY_MS=10
#PROCESS_ECHO_DECAY=0.5
#PROCESS_PEAK_DB=-1

# Broadcast voice chain for intros/raw/ (NOT intros/raw/*/clean, which stays gain-only):
#   level the take -> high-pass -> downward expander -> de-esser -> presence EQ
#   -> echo -> compressor -> limiter
# VOICE_CHAIN=0 turns the whole thing off and leaves just the echo + gain.
#VOICE_CHAIN=1
# The take is levelled to this before the dynamics, so thresholds behave the same
# whatever level you recorded at. Raise it for a harder-worked chain.
#VOICE_INPUT_TARGET_LUFS=-20
# 1. high-pass: removes rumble below this (0 = off)
#VOICE_HPF_HZ=100
# 2. downward expander: quiets fan/keyboard/breath between words
#VOICE_EXPANDER=1
#VOICE_EXPANDER_THRESHOLD_DB=-32
#VOICE_EXPANDER_RATIO=2
#VOICE_EXPANDER_RANGE_DB=-16
#VOICE_EXPANDER_ATTACK_MS=5
#VOICE_EXPANDER_RELEASE_MS=180
# 3. de-esser. NOTE: ffmpeg's de-esser does nothing below about i=0.4; useful range is
#    0.5 (gentle) to 1.0 (heavy). 0.6 cuts sibilance ~5 dB and leaves the voice alone.
#VOICE_DEESS=1
#VOICE_DEESS_INTENSITY=0.6
#VOICE_DEESS_MAX=0.5
#VOICE_DEESS_FREQ=0.5
# 4. presence boost for clarity
#VOICE_EQ=1
#VOICE_EQ_HZ=3500
#VOICE_EQ_GAIN_DB=4
#VOICE_EQ_Q=1
# 5. compressor: steadier volume, voice sits forward
#VOICE_COMP=1
#VOICE_COMP_THRESHOLD_DB=-24
#VOICE_COMP_RATIO=3
#VOICE_COMP_ATTACK_MS=8
#VOICE_COMP_RELEASE_MS=120
#VOICE_COMP_MAKEUP_DB=0
# 6. limiter: nothing gets past this ceiling
#VOICE_LIMIT=1
#VOICE_LIMIT_CEILING_DB=-1

# Playlist import — only used if importer.mjs is installed (console: import <url> [folder]).
# Without keys, Spotify playlists come from the embed page (lags edits, max 100 tracks). For live
# reads: create a free app at developer.spotify.com with redirect URI <PUBLIC_URL>/spotify/callback,
# set these, restart, then open <PUBLIC_URL>/spotify/login?token=<ADMIN_TOKEN> once in a browser.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
# yt-dlp is auto-downloaded into bin/ if not found. Cookies file if YouTube blocks the server IP:
#YTDLP_COOKIES=/home/container/cookies.txt
#YTDLP_PATH=/home/container/bin/yt-dlp

# Where `export` writes archive renders (served at /exports/, not part of the stream)
#EXPORTS_DIR=/home/container/exports
